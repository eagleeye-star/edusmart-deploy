# Copy this file to .env.local and fill in your real Supabase project
# values (Settings → API in your Supabase dashboard). .env.local is
# gitignored and will never be committed — this .env.example file is
# the only one that goes into the repo.
#
# For deployment (e.g. Vercel), set these same two variables in your
# hosting provider's Environment Variables settings instead of a file.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here
